SAMPLE_VARIABLE=this-is-an-environment-variable

# Enhanced zero forcing backend (see server.js / README.md)
# Port the Express backend listens on (defaults to 5051).
FORCING_API_PORT=5051
# Base URL the frontend should call for the backend API. Leave blank for
# relative requests (used by the dev-server proxy and same-origin deploys);
# set to a full URL (e.g. https://api.example.com) for a separately hosted
# backend.
FORCING_API_BASE_URL=
